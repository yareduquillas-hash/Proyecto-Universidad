# =============================================================================
# Núcleo Los Teques — Variables de entorno
# Copia este archivo a .env y ajusta los valores.
# Genera secretos con:  python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# -----------------------------------------------------------------------------
# DESARROLLO (local) — valores por defecto del proyecto
# -----------------------------------------------------------------------------
FLASK_ENV=development
# Secretos de solo-desarrollo (NO sirven para producción; el arranque en
# producción los rechaza). En producción genera unos nuevos en la sección PROD.
SECRET_KEY=dev-secret-key-solo-para-desarrollo-local-no-usar-en-prod
JWT_SECRET_KEY=dev-jwt-secret-solo-para-desarrollo-local-no-usar-en-prod
# DATABASE_URL se genera automáticamente en config.py con ruta absoluta (SQLite)
# DATABASE_URL=sqlite:///nucleo_los_teques.db
PORT=5000

# -----------------------------------------------------------------------------
# PRODUCCIÓN — obligatorio al desplegar (docker compose / servidor real)
# Activa con FLASK_ENV=production y rellena TODOS los valores de este bloque.
# -----------------------------------------------------------------------------
# FLASK_ENV=production
# SECRET_KEY=<64 hex generados>
# JWT_SECRET_KEY=<otros 64 hex distintos>
# POSTGRES_USER=nucleo
# POSTGRES_PASSWORD=<clave fuerte distinta de los anteriores>
# POSTGRES_DB=nucleo
# Si cambias POSTGRES_PASSWORD, define también DATABASE_URL con la misma clave:
# DATABASE_URL=postgresql://nucleo:<misma_clave>@db:5432/nucleo
# Dominio detrás del reverse proxy (Caddy): obtiene HTTPS automáticamente.
# SITE_ADDRESS=tudominio.example.com
# CORS_ORIGINS=https://tudominio.example.com
# PORT=5000

# -----------------------------------------------------------------------------
# Comunes (desarrollo y producción según necesites)
# -----------------------------------------------------------------------------
# JWT (horas de access, días de refresh)
JWT_ACCESS_HOURS=2
JWT_REFRESH_DAYS=7
# Uploads (MB)
MAX_CONTENT_LENGTH_MB=15
MAX_PDF_MB=10
# Asistencia
UMBRAL_INASISTENCIA_PERCENT=25
# Email recuperación (Gmail). Si se deja vacío, el código solo se loguea (dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@nucleoteques.local
SMTP_USE_TLS=1
PASSWORD_RESET_TTL_MIN=15
PASSWORD_RESET_MAX_INTENTOS=5
